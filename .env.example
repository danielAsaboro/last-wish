# Server-only credentials. Never prefix these with NEXT_PUBLIC_.
KEEPERHUB_API_KEY=
KEEPERHUB_BASE_URL=https://app.keeperhub.com
KEEPERHUB_MCP_URL=https://app.keeperhub.com/mcp
# Optional OAuth token. Operator scripts fall back to KEEPERHUB_API_KEY.
KEEPERHUB_MCP_ACCESS_TOKEN=
LASTWISH_PUBLIC_URL=
KEEPERHUB_REPORT_PRICE=0.10
LASTWISH_REPORT_TEST_CHAIN_ID=84532
LASTWISH_REPORT_TEST_VAULT=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-5-mini

# Base Sepolia is preferred. Set 11155111 only when KeeperHub preflight requires Sepolia.
NEXT_PUBLIC_CHAIN_ID=84532
NEXT_PUBLIC_BASE_SEPOLIA_RPC_URL=
NEXT_PUBLIC_SEPOLIA_RPC_URL=
BASE_SEPOLIA_RPC_URL=
SEPOLIA_RPC_URL=

# Set after the factory is deployed and independently verified on the selected testnet.
NEXT_PUBLIC_LASTWISH_FACTORY_ADDRESS=
